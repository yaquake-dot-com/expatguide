# ============================================
# Database
# ============================================
# Local (Docker): postgresql://expatguide:expatguide@localhost:5432/expatguide
# Neon (prod):    postgresql://...@...neon.tech/expatguide?sslmode=require
DATABASE_URL=""

# Neon direct connection (for Prisma migrations only, prod)
# DIRECT_URL=""

# ============================================
# Auth.js
# ============================================
# Generate: openssl rand -hex 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ============================================
# Storage
# ============================================
# "local" for development, "r2" for production
STORAGE_PROVIDER="local"

# Cloudflare R2 (prod only)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="expatguide"
# R2_PUBLIC_URL=""

# ============================================
# Email (Magic Link, prod only)
# ============================================
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
# EMAIL_FROM="noreply@your-domain.com"

# ============================================
# App
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
